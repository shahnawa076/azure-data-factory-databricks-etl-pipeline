{
	"name": "pl_mart",
	"properties": {
		"activities": [
			{
				"name": "MonthlySales",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/ADFProject/Mart/MonthlySales_Report"
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricks1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Copy monthly_sales",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "MonthlySales",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ParquetSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"wildcardFileName": "*.parquet",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "ParquetReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "IF NOT EXISTS(\n     SELECT 1\n     FROM INFORMATION_SCHEMA.TABLES\n     WHERE TABLE_NAME = 'monthly_sales' AND TABLE_SCHEMA='dbo'\n)\nBEGIN\n    CREATE TABLE dbo.monthly_sales\n    (\n        Month VARCHAR(50),\n        Fiscal_Year VARCHAR(50),\n        Revenue DECIMAL(20, 2),\n        Profit DECIMAL(20, 2),\n        QuantitySold bigint\n\n    );\nEND\nELSE\nBEGIN\n    TRUNCATE TABLE [dbo] . [monthly_sales];\nEND;",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": true,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_parquet",
						"type": "DatasetReference",
						"parameters": {
							"container": "processed",
							"filename": "monthly_sales.parquet"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_azsql",
						"type": "DatasetReference",
						"parameters": {
							"schema_name": "dbo",
							"table_name": "monthly_sales"
						}
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-08-08T09:53:00Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}